generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model WynntilsArgument {
    id           Int               @id @default(autoincrement())
    name         String            @db.VarChar(255)
    description  String
    required     Boolean
    functionId   Int?              @map("functionid")
    type         type
    defaultValue String?           @map("defaultvalue") @db.VarChar(255)
    function     WynntilsFunction? @relation(fields: [functionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@map("wynntilsargument")
}

model WynntilsFunction {
    id          Int               @id @default(autoincrement())
    name        String            @unique @db.VarChar(255)
    description String
    aliases     String[]          @db.VarChar(255)
    returnType  type              @map("returntype")
    arguments   WynntilsArgument[]

    @@map("wynntilsfunction")
}

model WynntilsDataVersion {
    id          Int    @id @default(autoincrement())
    harvestedAt BigInt @map("harvestedat")
    modVersion  String @map("modversion") @db.VarChar(255)

    @@map("wynntilsdataversion")
}

enum type {
    Integer
    CappedValue
    Number
    String
    Boolean
    Double
    Location
    NamedValue
    Long
    RangedValue
    CustomColor
    Object
    StyledText
    Time
    Float
    List
}
